# Google Maps JavaScript API key.
# Enable the "Maps JavaScript API" and billing on the Cloud project, then
# restrict the key by HTTP referrer for anything public.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID for a VECTOR map with Tilt and Rotation enabled.
# A raster Map ID cannot render 3D and cannot host WebGLOverlayView.
VITE_GOOGLE_MAPS_MAP_ID=

# Optional: serve the JSON/GeoJSON data from somewhere else (default: "data").
# VITE_DATA_BASE=https://example.org/bulacan-flood-data
